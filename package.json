{
  "name": "nengi",
  "version": "2.0.0-rc.124",
  "description": "High-performance realtime multiplayer networking for TypeScript games.",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "docs/ai"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npx jest",
    "build": "npx tsc",
    "typecheck": "npx tsc --project tsconfig.test.json",
    "verify:docs": "node scripts/verify-ai-docs.mjs",
    "profile:snapshot": "node --import tsx src/performance/SnapshotPipeline.performance.ts",
    "lint": "npx eslint . --config .eslintrc.js",
    "lintfix": "npx eslint . --fix --config .eslintrc.js"
  },
  "author": "Alex // timetocode",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.8",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  }
}
