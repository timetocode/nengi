{
  "name": "nengi",
  "version": "2.0.0-rc.125",
  "description": "High-performance realtime multiplayer networking for TypeScript games.",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "docs/ai"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "test": "jest",
    "build": "npm run clean && tsc",
    "build:family": "node scripts/build-package-family.mjs",
    "typecheck": "tsc --project tsconfig.test.json",
    "verify:docs": "node scripts/verify-ai-docs.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "npm run lint && npm run typecheck && npm test -- --runInBand && npm run build:family && npm run verify:docs && npm run verify:release",
    "release:publish": "node scripts/publish-package-family.mjs",
    "release:publish:dry-run": "node scripts/publish-package-family.mjs --dry-run",
    "prepack": "npm run build",
    "profile:snapshot": "node --import tsx src/performance/SnapshotPipeline.performance.ts",
    "lint": "npx eslint . --config .eslintrc.js",
    "lintfix": "npx eslint . --fix --config .eslintrc.js"
  },
  "author": "Alex // timetocode",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timetocode/nengi.git"
  },
  "homepage": "https://github.com/timetocode/nengi#readme",
  "bugs": {
    "url": "https://github.com/timetocode/nengi/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.8",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.46.0",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  }
}
